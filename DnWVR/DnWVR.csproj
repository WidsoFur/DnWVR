<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DnWVR</AssemblyName>
    <RootNamespace>DnWVR</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DeployDir>$(GameDir)\Mods</DeployDir>
    <!-- Like the BepInEx build: into a game with no MelonLoader installed, a stray Mods folder is all it would leave -->
    <DeployGate>$(GameDir)\MelonLoader
et35\MelonLoader.dll</DeployGate>
  </PropertyGroup>

  <!-- The BepInEx half of src\Loader belongs to the other project -->
  <ItemGroup>
    <Compile Remove="src\Loader\BepInEx*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\build\Game.props" />

  <!-- MelonLoader -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckMelonLoader" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MelonDir)\MelonLoader.dll')" Text="MelonLoader assemblies not found in '$(MelonDir)'. They ship in refs\ - see refs\README.md." />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)..\build\Deploy.targets" />

</Project>
