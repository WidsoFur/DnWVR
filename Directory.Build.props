<Project>
  <!-- Optional machine-specific overrides (git-ignored), e.g. <GameDir>D:\SteamLibrary\steamapps\common\Drag'n Wash</GameDir> -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <!-- The mod's version, shared by every loader's build and read by tools\package-release.ps1 -->
    <Version>0.1.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Drag'n Wash</GameDir>
    <GameDataDir>$(GameDir)\DragNWash_Data</GameDataDir>
    <ManagedDir>$(GameDataDir)\Managed</ManagedDir>
    <MelonDir>$(GameDir)\MelonLoader\net35</MelonDir>
    <!-- BepInEx is not on NuGet, so it is compiled against out of refs\ unless the game has it installed -->
    <BepInExDir Condition="'$(BepInExDir)' == '' And Exists('$(GameDir)\BepInEx\core\BepInEx.dll')">$(GameDir)\BepInEx\core</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildThisFileDirectory)refs\bepinex5</BepInExDir>
    <!-- Unity XR assemblies: the provider in this repository (openxr\), else the copies a release installed into the game -->
    <XRProviderDir>$(MSBuildThisFileDirectory)openxr</XRProviderDir>
    <XRManagedDir Condition="'$(XRManagedDir)' == '' And Exists('$(XRProviderDir)\Managed\Unity.XR.OpenXR.dll')">$(XRProviderDir)\Managed</XRManagedDir>
    <XRManagedDir Condition="'$(XRManagedDir)' == ''">$(ManagedDir)</XRManagedDir>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- Keep the machine out of the binaries: embedded source and pdb paths become /_/... -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
  </PropertyGroup>
</Project>
